# ============================================================
# SAPES Server Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit the real .env file to version control.
# ============================================================

# ----- MongoDB -----------------------------------------------
# Local development:
MONGO_URI=mongodb://localhost:27017/sapes_dev
# Shared Atlas (replace with your cluster connection string):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sapes_dev?retryWrites=true&w=majority

# ----- Server ------------------------------------------------
PORT=5001

# ----- JWT ---------------------------------------------------
# Generate a secure random secret (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# ----- Google OAuth 2.0 -------------------------------------
# Obtain from Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ----- SMTP (Password Reset Emails) -------------------------
# Required for password-reset email delivery.
# Leave blank to disable email sending (reset flow will fail silently).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com
