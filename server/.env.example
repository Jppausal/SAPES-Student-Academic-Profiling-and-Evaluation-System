# MongoDB Atlas connection string must select the sapes_dev database.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/sapes_dev?retryWrites=true&w=majority

# Replace with a unique random secret. Never commit server/.env.
JWT_SECRET=replace-with-a-unique-random-secret
PORT=5001

# Optional: comma-separated DNS resolvers for Atlas SRV lookup issues.
MONGO_DNS_SERVERS=

# Optional: required only when Google sign-in is enabled.
GOOGLE_CLIENT_ID=
