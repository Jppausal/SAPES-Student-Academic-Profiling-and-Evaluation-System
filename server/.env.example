# MongoDB Atlas URI for the SAPES development database.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/sapes_dev?retryWrites=true&w=majority

# Use a unique secret in server/.env; never commit or share it.
JWT_SECRET=replace-with-a-unique-random-secret

PORT=5001

# Optional: comma-separated DNS resolvers if Atlas SRV lookup fails on your network.
MONGO_DNS_SERVERS=

# Optional: only needed for Google sign-in.
GOOGLE_CLIENT_ID=
