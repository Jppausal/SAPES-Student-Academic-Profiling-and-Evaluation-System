# MongoDB Atlas connection string. Use the database that contains the SAPES role collections.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/DATABASE?retryWrites=true&w=majority

# Generate a unique value for each environment; do not commit your real secret.
JWT_SECRET=replace-with-a-unique-random-secret

PORT=5001

# Optional: required only if your DNS resolver cannot resolve Atlas SRV records.
MONGO_DNS_SERVERS=

# Optional: required only when using Google sign-in.
GOOGLE_CLIENT_ID=
