# ============================================================
# SAPES Client Environment Variables (Vite)
# Copy this file to .env and fill in all required values.
# NEVER commit the real .env file to version control.
# ============================================================

# ----- Google OAuth 2.0 -------------------------------------
# Must match the GOOGLE_CLIENT_ID configured in server/.env
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ----- API Base URL (optional) ------------------------------
# Leave blank for the Vite proxy, which forwards /api requests to
# http://127.0.0.1:5001 during local development.
VITE_API_URL=
